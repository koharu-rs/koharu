{
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tauri": "cargo tauri",
    "postinstall": "cargo install tauri-cli --git https://github.com/tauri-apps/tauri --rev 78f49ba3993fed5a1b921235c547731006ad2a74 --locked",
    "predev": "kill-port 3000",
    "dev": "cargo tauri dev",
    "build": "cargo tauri build --no-bundle",
    "docs": "bun run --filter @koharu/docs dev",
    "lint": "bun run --filter '@koharu/*' lint",
    "test": "bun run --filter @koharu/app test",
    "sponsors": "cd .github/sponsorkit && sponsorkit --force",
    "format": "oxfmt packages tests package.json .oxfmtrc.json .vscode",
    "check": "oxfmt --check packages tests package.json .oxfmtrc.json .vscode"
  },
  "devDependencies": {
    "@actions/artifact": "6.3.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "fflate": "0.8.3",
    "git-cliff": "^2.14.2",
    "kill-port": "^2.0.1",
    "oxfmt": "^0.74.0",
    "playwright": "1.64.1",
    "release-please": "17.11.2",
    "sponsorkit": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "^19.3.0",
    "sharp": "^0.35.5"
  }
}
