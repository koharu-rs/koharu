{
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tauri": "cargo tauri",
    "postinstall": "cargo install tauri-cli --version =3.0.0-alpha.1 --locked",
    "predev": "kill-port 3000",
    "dev": "cargo tauri dev",
    "build": "cargo tauri build --no-bundle",
    "docs": "bun run --filter @koharu/docs dev",
    "lint": "bun run --filter '@koharu/*' lint",
    "test": "bun run --filter @koharu/app test",
    "sponsors": "cd .github/sponsorkit && sponsorkit --force",
    "format": "oxfmt packages tests package.json .oxfmtrc.json .vscode",
    "check": "oxfmt --check packages tests package.json .oxfmtrc.json .vscode"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "git-cliff": "^2.13.1",
    "kill-port": "^2.0.1",
    "oxfmt": "^0.67.0",
    "playwright": "1.63.0",
    "sponsorkit": "^18.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@tauri-apps/api": "3.0.0-alpha.0",
    "react": "^19.3.0",
    "sharp": "^0.35.4"
  }
}
