{
  "license": "MIT OR Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tauri": "cargo tauri",
    "postinstall": "cargo install tauri-cli --git https://github.com/mayocream/tauri --rev 67bbfdf1696ad85db5be6931c9c66f45e22a736c --locked",
    "predev": "kill-port 3000",
    "dev": "cargo tauri dev",
    "build": "cargo tauri build --no-bundle",
    "docs": "bun run --filter @koharu/docs dev",
    "lint": "bun run --filter '@koharu/*' lint",
    "test": "bun run --filter @koharu/app test",
    "sponsors": "cd .github/sponsorkit && sponsorkit --force",
    "format": "oxfmt packages tests package.json .oxfmtrc.json .vscode",
    "check": "oxfmt --check packages tests package.json .oxfmtrc.json .vscode"
  },
  "devDependencies": {
    "@actions/artifact": "6.3.1",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "fflate": "0.8.3",
    "git-cliff": "^2.14.2",
    "kill-port": "^2.0.1",
    "oxfmt": "^0.79.0",
    "playwright": "1.65.1",
    "release-please": "17.11.2",
    "sponsorkit": "^19.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "^19.3.1",
    "sharp": "^0.35.5"
  }
}
