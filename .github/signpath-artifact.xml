<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" min-matches="0">
      <authenticode-sign />
    </pe-file>
    <pe-file path="*.dll" min-matches="0">
      <authenticode-sign />
    </pe-file>
    <msi-file path="*.msi" min-matches="0">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
